# Database
DATABASE_URL=sqlite:///./fraud.db

# Security (change in any shared environment)
JWT_SECRET=change-me-dev-secret
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
INGEST_API_KEY=dev-ingest-key
CONSOLE_BASE_URL=http://localhost:5173

# Seeded demo users (created only if the users table is empty)
SEED_ADMIN_PASSWORD=admin123
SEED_REVIEWER_PASSWORD=reviewer123
SEED_VIEWER_PASSWORD=viewer123

# Risk thresholds
FLAG_MIN_LEVEL=MEDIUM
ALERT_MIN_LEVEL=HIGH
HISTORY_LIMIT=200

# Event feed
EVENT_FEED_SIZE=200

# Notifications: log | sns | ses
NOTIFY_MODE=log
AWS_REGION=ap-south-1
SNS_TOPIC_ARN=
SES_SENDER=
SES_RECIPIENTS=
# Credentials come from the standard AWS chain (env vars, ~/.aws, AWS_PROFILE). Never commit them.
